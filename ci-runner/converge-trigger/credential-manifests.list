# Credential-bearing manifests (livespec-dev-tooling-ctete5). The converge trigger
# (apply-merged-ci-changes.sh) HOLDS any merged range that touches one of these
# paths and applies NOTHING from that range, because the ci_converge_unit role copies
# the whole tree in one step. The owner's own apply releases the hold.
#
# One path per line; a line ending in `/` is a directory prefix. Adding a credential
# manifest is one edit here (tests/livespec_dev_tooling/test_ci_converge_trigger.py
# refuses any committed manifest carrying a Secret or ServiceAccount that is not listed).
ci-runner/k3s/phase2/gates/gates-rbac.yaml
ci-runner/k3s/phase2/gates/gate-credentials.yaml
ci-runner/k3s/phase2/factory/factory-rbac.yaml
ci-runner/k3s/phase2/factory-mi-homelab/factory-mi-homelab.yaml
ci-runner/k3s/phase2/node-status-credential/node-status-patch-rbac.yaml
ci-runner/observability/kueue-webhook-probe-rbac.yaml
ci-runner/k3s/secret-reinjection/
ci-runner/k3s/phase2/warm-cache/
ci-runner/k3s/phase2/sccache/
